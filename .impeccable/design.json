  "narrative": {
    "northStar": "Hearth",
    "overview": "Pertahankan arah yang dikonfirmasi pengembang pada 1 November 2026: sidebar\narang hangat, bidang kerja krem, panel terang, dan aksen oranye. Dunia visual\nini mendukung pekerjaan administrasi yang padat melalui tabel rapi, hierarki\ntipografi, jarak, dan pengelompokan. Identitas resmi instansi masih menyusul.\n\nDokumen ini merekam rancangan K-3 di `/prototype/operator`, dengan sumber\n`resources/css/operator.css`. Desktop/laptop adalah perangkat kerja utama;\nponsel mendukung pemantauan dan tindakan singkat. Prototipe lokal memakai data\nsintetis dan perubahan dalam memori tab; refresh mereset demo. Berkas dibaca\ndi browser, pengiriman disimulasikan, dan tidak ada persistensi bisnis atau\npengiriman ke BKAD. Ini bukan bukti penyelesaian fitur backend.",
    "keyCharacteristics": [
      "Navigasi arang dengan bidang kerja krem dan panel putih hangat.",
      "Aksen oranye untuk tindakan utama; status selalu disertai teks.",
      "Tabel sebagai bidang kerja, dengan kelengkapan terpisah dari status paket.",
      "Ikon SVG garis, sudut lembut, dan bayangan tipis."
    ],
    "rules": [
      {
        "name": "The Status Text Rule",
        "body": "Warna tidak menggantikan label status atau penjelasan galat.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** pertahankan sidebar arang, kanvas krem, panel terang, dan aksen oranye.",
      "**Do** tampilkan kelengkapan dan status sebagai dua informasi berbeda.",
      "**Do** sediakan fokus terlihat, target interaksi minimal 40px, dan teks untuk status.",
      "**Do** nyatakan batas simulasi dan keberadaan berkas di browser dengan jujur."
    ],
    "donts": [
      "**Don't** menjadikan grafik dekoratif sebagai pengganti daftar kerja.",
      "**Don't** menyatakan identitas resmi instansi sebelum asetnya tersedia.",
      "**Don't** menyebut simulasi lokal sebagai penyimpanan server atau pengiriman nyata."
    ]
  }
}
